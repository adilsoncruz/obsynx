      },
      "id": 1,
      "title": "[OBSynx Custom] Volume Financeiro por Status (value_from: arg.amount, attributes_from: return.status)",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (payment_status) (payments_amount_BRL_total{service_name=\"go-api\"} or payments_amount_total{service_name=\"go-api\"})",
          "legendFormat": "Status: {{payment_status}}",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#0056D6"
          },
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0056D6",
                "value": null
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "title": "[OBSynx Custom] Pagamentos por Status Retornado (attributes_from: return.status)",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (payment_status) (payments_processed_total{service_name=\"go-api\"})",
          "legendFormat": "{{payment_status}}",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#00BFFF",
                "value": null
              },
              {
                "color": "#0056D6",
                "value": 40
              },
              {
                "color": "#E11D48",
                "value": 75
              }
            ]
          },
          "custom": {}
        }
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "title": "[OBSynx Custom] \u00daltimo Score Retornado por calculateCustomerRisk (value_from: return)",
      "type": "gauge",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(customer_risk_last_score{service_name=\"go-api\"})",
          "legendFormat": "Risk Score",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#0056D6"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2.5,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "axisBorderShow": false,
            "axisGridShow": true
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "id": 4,
      "title": "[OBSynx Custom] Chamadas por Fun\u00e7\u00e3o (processPayment & calculateCustomerRisk)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (code_function) (obsynx_business_calls_total{service_name=\"go-api\", code_function!=\"\"})",
          "legendFormat": "{{code_function}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#0056D6"
          },
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2.5,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "axisBorderShow": false,
            "axisGridShow": true
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "id": 5,
      "title": "[OBSynx Custom] Lat\u00eancia M\u00e9dia por Fun\u00e7\u00e3o (ms)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (code_function) (obsynx_business_duration_milliseconds_sum{service_name=\"go-api\", code_function!=\"\"}) / clamp_min(sum by (code_function) (obsynx_business_duration_milliseconds_count{service_name=\"go-api\", code_function!=\"\"}), 1)",
          "legendFormat": "{{code_function}} (avg ms)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#0056D6"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2.5,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "axisBorderShow": false,
            "axisGridShow": true
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "id": 6,
      "title": "[OpenTelemetry Nativo] HTTP Server Requests (http_server_request_duration_seconds_count / SpanMetrics HTTP)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_route, http_response_status_code) (http_server_request_duration_seconds_count{service_name=\"go-api\"})",
          "legendFormat": "HTTP {{http_route}} ({{http_response_status_code}})",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (span_name) (obsynx_business_calls_total{service_name=\"go-api\", span_kind=\"SPAN_KIND_SERVER\"})",
          "legendFormat": "Auto-HTTP Span: {{span_name}}",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#0056D6"
          },
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2.5,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "axisBorderShow": false,
            "axisGridShow": true
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "id": 7,
      "title": "[OpenTelemetry Nativo] Mem\u00f3ria RSS do Processo (process_resident_memory_bytes)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(process_resident_memory_bytes_By{service_name=\"go-api\"} or process_resident_memory_bytes{service_name=\"go-api\"})",
          "legendFormat": "Resident Memory (RSS)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#0056D6"
          },
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2.5,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "axisBorderShow": false,
            "axisGridShow": true
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "id": 8,
      "title": "[OpenTelemetry Nativo] Tempo de CPU & Telemetria OTel Collector (process_cpu_time_seconds_total)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(process_cpu_time_seconds_total{service_name=\"go-api\"})",
          "legendFormat": "CPU Time (seconds)",
          "refId": "A"
        }
      ]
    }
